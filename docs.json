{
  "$schema": "https://mintlify.com/docs.json",
  "name": "IronClaw",
  "description": "Secure personal AI assistant. Your data stays yours.",
  "theme": "mint",
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/assets/ironclaw.png",
    "dark": "/assets/ironclaw.png"
  },
  "favicon": "/assets/ironclaw.png",
  "colors": {
    "primary": "#5B6FFF",
    "dark": "#5B6FFF",
    "light": "#8B9AFF"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/nearai/ironclaw",
        "icon": "github"
      },
      {
        "label": "Releases",
        "href": "https://github.com/nearai/ironclaw/releases",
        "icon": "package"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Get Started",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Quick Start",
            "pages": [
              "start/getting-started",
              "start/wizard"
            ]
          }
        ]
      },
      {
        "tab": "Install",
        "groups": [
          {
            "group": "Installation",
            "pages": [
              "index",
              "quickstart",
              "onboard"
            ]
          },
          {
            "group": "Maintenance",
            "pages": [
              "install/updating",
              "install/uninstalling"
            ]
          }
        ]
      },
      {
        "tab": "Channels",
        "groups": [
          {
            "group": "Channels",
            "pages": [
              "tunnel",
              {
                "group": "Available Channels",
                "icon": "message",
                "pages": [
                  "channels/local",
                  "channels/signal",
                  "channels/telegram",
                  "channels/webhook"
                ]
              }
            ]
          },
          {
            "group": "Extensions (Tools)",
            "pages": [
              "extensions/web-search",
              "extensions/github"
            ]
          }
        ]
      }
    ]
  },
  "cname": "docs.ironclaw.ai",
  "custom": {
    "css": [
      "/custom.css"
    ]
  },
  "metadata": {
    "og:site_name": "IronClaw Docs",
    "og:type": "website",
    "og:title": "IronClaw — Secure Personal AI Assistant",
    "og:description": "Self-hosted AI assistant with defense-in-depth security. Your data stays yours, encrypted and local. Multi-channel access, parallel jobs, WASM sandbox, and skills system.",
    "og:image": "https://docs.ironclaw.ai/assets/ironclaw.png",
    "twitter:card": "summary_large_image",
    "twitter:site": "@ironclawai",
    "twitter:title": "IronClaw — Secure Personal AI Assistant",
    "twitter:description": "Self-hosted AI assistant with defense-in-depth security. Your data stays yours, encrypted and local.",
    "twitter:image": "https://docs.ironclaw.ai/assets/ironclaw.png"
  }
}
